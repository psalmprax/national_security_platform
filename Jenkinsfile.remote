pipeline {
    agent any

    environment {
        REMOTE_USER = 'ubuntu'
        REMOTE_HOST = '130.61.26.105'
        // Using credentialsId 'OCI_SSH_KEY' instead of a local host path
        DEPLOY_DIR = '/home/ubuntu/national_security_platform'
        // Host ports are unique
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy to Remote Server') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'OCI_SSH_KEY', keyFileVariable: 'SSH_KEY_PATH')]) {
                    script {
                        echo "Preparing remote deployment on ${REMOTE_HOST}..."
                        // Create deploy directory on remote
                        sh "ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} 'mkdir -p ${DEPLOY_DIR}'"
                        
                        // Sync files to remote via rsync
                        sh "rsync -avz -e 'ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no' --exclude '.git' --exclude 'venv' --exclude '__pycache__' . ${REMOTE_USER}@${REMOTE_HOST}:${DEPLOY_DIR}"
                        
                        // Generate certificates on the remote host if they don't exist
                        echo "Ensuring certificates are present on remote..."
                        sh "ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} 'cd ${DEPLOY_DIR} && chmod +x scripts/generate_certs.sh && ./scripts/generate_certs.sh'"
                    }
                }
            }
        }

        stage('Rebuild and Start Services') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'OCI_SSH_KEY', keyFileVariable: 'SSH_KEY_PATH')]) {
                    script {
                        echo "Restarting Docker Compose services..."
                        sh """
                            ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                                cd ${DEPLOY_DIR}
                                # Ensure .env exists with proper values - copy from example if needed
                                if [ ! -f .env ]; then 
                                    cp .env.example .env
                                fi
                                # Generate secrets if missing in .env
                                source .env 2>/dev/null || true
                                if [ -z "${JWT_SECRET}" ]; then
                                    echo "JWT_SECRET=$(openssl rand -base64 32)" >> .env
                                fi
                                if [ -z "${MASTER_ENCRYPTION_KEY}" ]; then
                                    echo "MASTER_ENCRYPTION_KEY=$(openssl rand -hex 16 | base64)" >> .env
                                fi
                                if [ -z "${VAULT_ROLE_ID}" ]; then
                                    echo "VAULT_ROLE_ID=16296aec-baed-fee5-e859-21daf3afc67e" >> .env
                                fi
                                if [ -z "${VAULT_SECRET_ID}" ]; then
                                    echo "VAULT_SECRET_ID=1a497874-91b0-79d2-89bc-add1621ebc74" >> .env
                                fi
                                if [ -z "${VAULT_DEV_ROOT_TOKEN}" ]; then
                                    echo "VAULT_DEV_ROOT_TOKEN=root" >> .env
                                fi
                                if [ -z "${MINIO_ROOT_PASSWORD}" ]; then
                                    echo "MINIO_ROOT_PASSWORD=change_this_password_123" >> .env
                                fi
                                if [ -z "${NATS_TOKEN}" ]; then
                                    echo "NATS_TOKEN=nats_token_change_immediately" >> .env
                                fi
                                docker-compose down --remove-orphans
                                docker-compose build
                                docker-compose up -d
                            '
                        """
                    }
                }
            }
        }

        stage('Seed Test Data') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'OCI_SSH_KEY', keyFileVariable: 'SSH_KEY_PATH')]) {
                    script {
                        echo "Seeding CockroachDB with platform data..."
                        sh """
                            ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} '
                                cd ${DEPLOY_DIR}
                                chmod +x seed_database.sh
                                ./seed_database.sh
                            '
                        """
                    }
                }
            }
        }

        stage('Final Health Check') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'OCI_SSH_KEY', keyFileVariable: 'SSH_KEY_PATH')]) {
                    script {
                        echo "Verifying service health..."
                        // Check if Gateway is responding on port 8443
                        sh "ssh -i ${SSH_KEY_PATH} -o StrictHostKeyChecking=no ${REMOTE_USER}@${REMOTE_HOST} 'curl -sk https://localhost:8443/health/core || (echo \"Health check failed\" && exit 1)'"
                    }
                }
            }
        }
    }

    post {
        always {
            echo "CI/CD Pipeline finished execution."
        }
        success {
            echo "✅ Deployment Successful: National Security Platform is live."
        }
        failure {
            echo "❌ Deployment Failed: Please check the logs."
        }
    }
}
